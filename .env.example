# Resend — slanje upita s kontakt forme
# 1. Registrirajte se na https://resend.com i verificirajte domenu cortex.hr
# 2. Kreirajte API ključ i upišite ga u .env.local (ne commitati!)
RESEND_API_KEY=
# Adresa na koju stižu upiti
CONTACT_TO=info@cortex.hr
# Pošiljatelj (mora biti na verificiranoj domeni)
CONTACT_FROM=Cortex web <web@cortex.hr>
